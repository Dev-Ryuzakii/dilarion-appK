# Baked into the build (Vite reads this at `npm run build`). Afribase builds
# static sites without the dashboard's env vars, so this file IS the config.
VITE_API_BASE=https://apidilarion.eibstratoc.com
# Release downloads are served from the VPS at the bare domain
# dilarion.eibstratoc.com (nginx on 41.242.60.238). APK MIME is set there so
# Android installs instead of unzipping.
VITE_DOWNLOAD_BASE=https://dilarion.eibstratoc.com
