{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "call",
  "description": "Capability for the standalone call window — its own OS window (like WhatsApp Desktop), not a modal inside the main window",
  "windows": ["call"],
  "permissions": [
    "core:default",
    "core:event:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://testdilarion.eibstratoc.com/**" },
        { "url": "https://apidilarion.eibstratoc.com/**" }
      ]
    },
    "notification:default"
  ]
}
